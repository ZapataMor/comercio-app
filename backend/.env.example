APP_NAME=Vitrina
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Bogota

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=comercio_api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cambios en vivo (WebSockets) con Laravel Reverb: `php artisan reverb:start`.
# La app se conecta al puerto 8080 (en el emulador: adb reverse tcp:8080 tcp:8080).
# REVERB_APP_KEY no es secreta y debe coincidir con EN_VIVO_KEY de frontend/src/config.ts.
# Sin Reverb corriendo todo sigue funcionando, solo que la app se entera más tarde.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=vitrina
REVERB_APP_KEY=vitrina-local
REVERB_APP_SECRET=cambia-este-secreto
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Códigos por WhatsApp (registro, acceso y recuperación con el celular).
# log = modo prueba (el código va a storage/logs/laravel.log); cloud = WhatsApp Cloud API de Meta.
# Pasos: Vitrina/00 - Inicio/Configurar WhatsApp Cloud API.md
WHATSAPP_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PLANTILLA_CODIGO=codigo_vitrina
WHATSAPP_PLANTILLA_IDIOMA=es
WHATSAPP_API_VERSION=v23.0

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Minutos hasta que un token Sanctum expira (60*24*7 = 7 dias)
SANCTUM_TOKEN_EXPIRATION=10080

# Firebase Cloud Messaging: ruta al JSON de la service account (SECRETO).
# Ejemplo: FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json
FIREBASE_PROJECT=app
FIREBASE_CREDENTIALS=

# Reporte de errores (Sentry). Vacío = no se envía nada (lo normal en desarrollo).
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Datos de la política de privacidad y de los correos (ver DESPLIEGUE.md)
VITRINA_RESPONSABLE="Vitrina"
VITRINA_CORREO_CONTACTO=soporte@vitrina.example
VITRINA_CIUDAD="Maicao, La Guajira, Colombia"
FOTOS_ENTREGA_OBLIGATORIAS=false
